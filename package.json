{
  "name": "obmind",
  "version": "1.18.15",
  "description": "Turn the current note's headings and indentation into an interactive, XMind-style mindmap that edits the note back.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/runTest.mjs"
  },
  "keywords": [
    "obsidian",
    "mindmap",
    "outline"
  ],
  "author": "郭源潮",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "markmap-common": "^0.18.0",
    "markmap-lib": "^0.18.0",
    "markmap-view": "^0.18.0",
    "obsidian": "^1.4.0"
  },
  "devDependencies": {
    "builtin-modules": "^3.3.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
