{
  "name": "obmind",
  "version": "1.10.0",
  "description": "Turn the current note's outline (filename as root, indentation as hierarchy) into an interactive mindmap.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "mindmap", "outline"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "markmap-common": "^0.18.0",
    "markmap-lib": "^0.18.0",
    "markmap-view": "^0.18.0",
    "obsidian": "^1.4.0"
  },
  "devDependencies": {
    "builtin-modules": "^3.3.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
